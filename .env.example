# Copy to .env and fill in. .env is gitignored; this file is not — never put
# real values here.
#
# NAMING RULE, and it matters: Vite inlines any VITE_-prefixed variable into the
# browser bundle. Anything without the prefix stays server-side. Putting a secret
# behind VITE_ ships it to every visitor, so the prefix is the trust boundary.

# ---------------------------------------------------------------------------
# Supabase — Project Settings > API
# ---------------------------------------------------------------------------

# Safe to expose. The anon key is designed to be public; Row Level Security is
# what actually protects the data, which is why 0002_rls.sql exists.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=

# SECRET. Bypasses RLS entirely — full read/write on every table. Only the
# ingestion/AI pipeline uses it. Never VITE_-prefix this, never send it to the
# browser, never log it.
SUPABASE_SERVICE_ROLE_KEY=

# Project ref only (the subdomain above), used by the Supabase CLI to link and
# push migrations.
SUPABASE_PROJECT_REF=

# ---------------------------------------------------------------------------
# DeepSeek — platform.deepseek.com/api_keys
# ---------------------------------------------------------------------------

# SECRET. Server-side only: clustering, scoring and digest generation.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Model ids kept as config so tiers can be retuned from real token counts
# without touching pipeline code. Verified against GET /models on 2026-08-22:
# deepseek-v4-flash (high volume), deepseek-v4-pro (user-facing quality).
MODEL_CLUSTER=deepseek-v4-flash
MODEL_DIGEST=deepseek-v4-pro
MODEL_REASON=deepseek-v4-pro

# Two ceilings, because they bound different things and neither substitutes
# for the other.
#
# AI_MONTHLY_TOKEN_BUDGET caps tokens. It stops a runaway loop, but it does not
# cap money: a token's price varies about thirtyfold across routes, so the same
# token count can produce very different invoices.
#
# AI_MONTHLY_COST_USD caps dollars, priced from src/lib/ai/cost.ts at the moment
# each call is reserved. This is the one that guarantees the bill. Whichever
# ceiling is reached first stops new model calls for the rest of the calendar
# month; /admin/cost shows burn and a projected exhaustion date against it.
#
# Sizing, for the ~70 feeds seeded by 0006_sources.sql: the dominant cost is
# `analyse` (one deepseek-v4-pro call per event, roughly 100-200 events/day),
# with `cluster` on flash a distant second and Ask smaller still. That is on the
# order of 20M tokens and $25-30/month. So $10 is a real constraint, not a
# formality — expect the pipeline to stop partway through the month at this
# ceiling unless you also reduce the active source count. Watch /admin/cost for
# the first week and either raise the ceiling once subscriptions cover it, or
# deactivate sources until the projection fits.
AI_MONTHLY_TOKEN_BUDGET=500000
AI_MONTHLY_COST_USD=10

# ---------------------------------------------------------------------------
# Other AI providers — optional
# ---------------------------------------------------------------------------
#
# Since 0003_admin.sql, which provider serves each tier is a database row, not
# code: Admin → AI providers routes cluster/digest/reason at whatever is active.
#
# The KEY ITSELF IS NEVER STORED IN THE DATABASE. An `ai_providers` row records
# the NAME of the variable holding the key (`api_key_env`), so a leaked database
# is not a leaked provider account, and a provider row is safe to log and back
# up. That is why switching provider is two steps and not one:
#
#   1. set the secret here (or `wrangler secret put NAME` in production)
#   2. activate the provider and point a tier at it in the console
#
# Rows are seeded for these four, inactive and awaiting a key. Uncomment the one
# you actually use — an active provider whose variable is unset shows up in the
# console as a missing secret rather than failing at request time.

# OPENAI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# TOGETHER_API_KEY=

# --- Resend ---------------------------------------------------------------
# https://resend.com/api-keys
RESEND_API_KEY=

# Dev: onboarding@resend.dev delivers only to your own address.
# Prod: an address on a domain verified in Resend. Use a nyuz domain rather
# than one shared with another product — sending reputation attaches to the
# domain, not the key.
RESEND_FROM_EMAIL=

# SECRET. HMAC key for public one-click unsubscribe links. Generate at least
# 32 random bytes and keep it stable; rotating it revokes outstanding links.
EMAIL_UNSUBSCRIBE_SECRET=

# --- Site -----------------------------------------------------------------
# Absolute origin, no trailing slash. Email has no base URL, so every link in a
# message is built from this. Defaults to http://localhost:8080 when unset.
VITE_SITE_URL=

# SECRET. Bearer/query token protecting /api/health for an external uptime check.
HEALTHCHECK_TOKEN=

# --- Economics provider sync ---------------------------------------------
# Cloudflare Billable Usage API (read-only Billing Read token). The sync stores
# account-scoped imported snapshots and never exposes this token to the browser.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Supabase Management API fine-grained token with analytics_usage_read, scoped
# to the project below. This imports API usage only; billing scope stays explicit
# and unavailable until a documented billing endpoint is configured.
SUPABASE_PROJECT_REF=
SUPABASE_MANAGEMENT_TOKEN=

# --- Stripe ---------------------------------------------------------------
# Secret key and webhook signing secret are server-only. The four Price ids
# must point at recurring USD prices for $14.99/$149.90 Plura and $29.99/$299.90 Omni,
# matching DEFAULT_PLAN_PRICES in src/lib/plans.ts. If they do not, the pricing
# page advertises one amount and checkout charges another.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLURA_MONTHLY=
STRIPE_PRICE_PLURA_ANNUAL=
STRIPE_PRICE_OMNI_MONTHLY=
STRIPE_PRICE_OMNI_ANNUAL=

# Grandfathering. Stripe prices are immutable, so a repricing means creating new
# Price objects and pointing the four ids above at them. Put the ids they USED to
# hold here — the old $7/$69 and $15/$149 prices — and existing subscribers keep
# billing against the price they signed up on. Checkout refuses to sell a legacy
# price; the webhook still honours one. Leave blank if you have never repriced.
#
# Setting the four above WITHOUT filling these in is the dangerous case: every
# current subscriber's next webhook resolves to no plan and they lose access.
STRIPE_PRICE_PLURA_MONTHLY_LEGACY=
STRIPE_PRICE_PLURA_ANNUAL_LEGACY=
STRIPE_PRICE_OMNI_MONTHLY_LEGACY=
STRIPE_PRICE_OMNI_ANNUAL_LEGACY=

# --- Telegram -------------------------------------------------------------
# BotFather → /newbot. Token is a secret; never VITE_-prefix it.
# Point the webhook at {VITE_SITE_URL}/api/telegram/webhook with the same
# secret_token as TELEGRAM_WEBHOOK_SECRET:
#   npm run telegram:webhook
# Locally that URL must be public HTTPS (a tunnel), or set the webhook after deploy.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Optional. If unset, the dashboard asks Telegram via getMe.
# TELEGRAM_BOT_USERNAME=

# --- Web Push -------------------------------------------------------------
# One OS notification per story. Public key is VITE_ because the browser needs
# it to subscribe. Private key is a secret. Generate a pair with:
#   npm run vapid
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:privacy@nyuz.app

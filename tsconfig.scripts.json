{
  // The operator scripts, typechecked separately from the app.
  //
  // They are not in the root tsconfig's `include` on purpose. That config sets
  // `types: ["vite/client"]` and nothing else, which is what stops application
  // code from quietly reaching for `process`, `Buffer` or `node:fs` — none of
  // which exist in the Cloudflare Workers runtime the server ships to.
  //
  // scripts/ runs on a laptop under Node, so it needs the opposite. Giving it its
  // own config buys both: the scripts get Node's globals, and the app keeps a
  // type system that refuses them.
  "extends": "./tsconfig.json",
  "include": ["scripts/**/*.ts"],
  "compilerOptions": {
    "types": ["node"]
  }
}

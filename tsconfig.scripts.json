{
  // The operator scripts, which the main tsconfig deliberately excludes: they
  // run on Node against the live project, not in the browser bundle, so they
  // are not part of the app's compilation.
  //
  // They were not typechecked at all until 2026-08-30, and that turned out to
  // matter. `scripts/pipeline.ts` holds `Record<EventOutcome["decision"],
  // string>` label maps, so adding a new outcome to the pipeline should be a
  // compile error until the CLI knows how to print it. It was not — the new
  // `no_demand` decision printed as the literal string "undefined" in a real
  // run, in the tool this project uses to make every one of its "verified"
  // claims.
  //
  // `src` is included as well, not to check it twice, but because the scripts
  // import from it and the compiler needs the graph.
  "extends": "./tsconfig.json",
  // The Playwright config and its specs are here for the same reason the
  // operator scripts are: they run on Node, against the built Worker, rather
  // than in the browser bundle. They were outside every tsconfig until
  // 2026-10-03, which meant a typo in a spec was a runtime failure in a job that
  // takes three minutes to reach it -- and the thing being asserted on is the
  // deploy, so a silently skipped assertion is worse than a red one.
  "include": [
    "scripts/**/*.ts",
    "src/**/*.ts",
    "e2e/**/*.ts",
    "playwright.config.ts"
  ]
}

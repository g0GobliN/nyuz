# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
.output
.vinxi
.tanstack/**
.nitro
*.local

# Wrangler / Cloudflare
.wrangler/
.dev.vars

# Supabase CLI scratch — version checks and link state, not project files
supabase/.temp/

# Coverage: a measurement, regenerated by `npm run test:coverage`. Kept out of
# git deliberately — the floor that IS committed lives in .ci/baseline/.
coverage/

# Playwright: traces, screenshots and the HTML report from `npm run e2e`. The
# traces are the evidence for a failed run and belong in the CI artifact, not in
# a commit.
test-results/
playwright-report/
blob-report/


# Local email template previews (scripts/email-preview.ts)
.email-preview/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment / secrets — never commit
.env
.env.*
!.env.example
.freebuff
.agents
.claude
.codex

# Brief-quality loop state (local working notes, not project files)
.scratch/

# Scratch output from the reader-quality scripts — frozen corpora, audit dumps,
# re-extraction diffs. Regenerated by the commands in docs/briefing-quality-handoff.md,
# and never a project file: a measurement belongs in a report, not a commit.
tmp/
